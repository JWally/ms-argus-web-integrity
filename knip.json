{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/index-iframe.ts",
    "src/index-vm.ts",
    "src/loader/index.ts",
    "bin/*.ts",
    "lib/**/*.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.ts",
    "lib/**/*.ts",
    "bin/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "**/*.test.ts",
    "scripts/**",
    "src/webgl/constants-lite.ts",
    "src/utils/exile.ts",
    "src/utils/html.ts",
    "src/worker/types.ts"
  ],
  "ignoreDependencies": [
    "ts-node",
    "acorn",
    "@webgpu/types",
    "lefthook",
    "patchright"
  ],
  "exclude": ["types", "nsTypes", "exports", "duplicates"]
}
