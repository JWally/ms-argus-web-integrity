{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/index-vm.ts",
    "bin/*.ts",
    "lib/**/*.ts"
  ],
  "project": ["src/**/*.ts", "lib/**/*.ts", "bin/**/*.ts"],
  "ignore": [
    "**/*.test.ts",
    "scripts/**",
    "src/webgl/constants-lite.ts",
    "src/utils/exile.ts",
    "src/utils/html.ts",
    "src/worker/types.ts"
  ],
  "ignoreDependencies": ["ts-node", "acorn", "@rollup/plugin-replace", "@rollup/plugin-terser", "@webgpu/types", "lefthook", "javascript-obfuscator"],
  "exclude": ["types", "nsTypes", "exports", "duplicates"]
}
