{
  "name": "argus",
  "version": "2.0.0",
  "description": "Browser fingerprinting library for fraud and bot detection",
  "main": "dist/argus.esm.js",
  "module": "dist/argus.esm.js",
  "browser": "dist/argus.iife.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/argus.esm.js",
      "require": "./dist/argus.esm.js",
      "browser": "./dist/argus.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node server.js",
    "dev": "rollup --config rollup.config.mjs -w & nodemon -d 3 ./server.js localhost 8000",
    "build": "rollup --config rollup.config.mjs",
    "compile:vm": "npx tsx scripts/compile-vm.ts",
    "build:prod": "npm run compile:vm && rollup --config rollup.config.mjs && npm run minify && bash scripts/verify-build.sh",
    "build:css": "tailwindcss -i public/tw-input.css -o public/styles.css --content 'public/index.html' --minify",
    "build:demo": "npm run build && npm run build:css && cp public/index.html public/styles.css dist/",
    "minify": "terser dist/argus.esm.js -o dist/argus.esm.min.js --source-map && terser dist/argus.iife.js -o dist/argus.iife.min.js --source-map",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:test": "eslint src --ext .ts --fix-dry-run",
    "deps": "depcruise --config .dependency-cruiser.cjs src lib",
    "dead-code": "knip",
    "quality": "npm run lint:test && npm run deps && npm run dead-code && npm run duplication",
    "format": "prettier --write src/**/*.ts",
    "baseline:capture": "node scripts/capture-baseline.js",
    "baseline:compare": "node scripts/compare-fingerprint.js",
    "update:features": "npx tsx scripts/update-features-mdn.ts",
    "update:features:local": "npx tsx scripts/update-features.ts",
    "update:timezones": "npx tsx scripts/update-timezones.ts",
    "serve:demo": "npm run build:demo && npx http-server dist -p 8080 -c-1 --cors",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy",
    "cdk:diff": "cdk diff",
    "duplication": "jscpd src",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamjuliot/CreepJS.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abrahamjuliot/CreepJS/issues"
  },
  "homepage": "https://github.com/abrahamjuliot/CreepJS#readme",
  "dependencies": {
    "@types/pako": "^2.0.4",
    "aws-cdk-lib": "^2.189.1",
    "constructs": "^10.4.2",
    "detectincognitojs": "^1.6.2",
    "pako": "^2.1.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@webgpu/types": "^0.1.69",
    "acorn": "^8.16.0",
    "aws-cdk": "^2.189.1",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.21.2",
    "happy-dom": "^20.0.11",
    "jscpd": "^4.0.7",
    "knip": "^5.82.1",
    "lefthook": "^2.0.15",
    "nodemon": "^3.1.9",
    "playwright": "^1.57.0",
    "prettier": "3.4.2",
    "rollup": "^4.30.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.37.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.16"
  }
}
